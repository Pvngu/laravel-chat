{
    "name": "pvngu/laravel-chat",
    "description": "Slack-style chat for Laravel: conversations, channels, reactions, attachments and real-time updates. The backend for @pvngu/vue-chat.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "chat",
        "messaging",
        "conversations",
        "channels",
        "reverb",
        "vue"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pvngu\\Chat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pvngu\\Chat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pvngu\\Chat\\ChatServiceProvider"
            ],
            "aliases": {
                "Chat": "Pvngu\\Chat\\Facades\\Chat"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
